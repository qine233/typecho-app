<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮（记一笔 / 记体重）：跟玻璃卡同调的上亮下暗，半档就够了——
     这颗是卡片上唯一要「实心」的东西，透进壁纸用户就找不到按钮了。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_primary_bg"
        android:startColor="@color/widget_primary_bg_top"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
