    <color name="widget_primary_bg">#425AEF</color>
    <color name="widget_card_bg">#FFFFFF</color>
    <color name="widget_card_border">#E3E8F7</color>
    <!-- 下面四个只在选取器的示意图 widget_preview_* 里用，真卡片是 Glance 画的 -->
    <color name="widget_preview_text">#363636</color>
    <color name="widget_preview_faint">#B6BAC9</color>
    <color name="widget_preview_track">#E9ECF5</color>
    <!-- 健康那三张示意图里「往下走」的那支绿，和主题令牌 healthNormal 同色 -->
    <color name="widget_preview_down">#2F7A44</color>
