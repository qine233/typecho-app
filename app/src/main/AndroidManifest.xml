<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 自更新：从设置页里用户亲手放行，不是装上就有权 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 常驻状态通知。Android 13 起不给权限 notify() 直接抛异常。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager 的加急任务（通知上点「立即补交」）内部要借一次前台服务。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 更新包的下载挂在前台服务上，Android 14 起这类服务要单独声明用途。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TypechoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TypechoApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TypechoApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 只接自己发的 PendingIntent，不对外暴露 -->
        <receiver
            android:name=".data.sync.StatusActionReceiver"
            android:exported="false" />

        <!-- 桌面小组件：一个 receiver 就是一格规格，选取器里能各选各的。
             Glance 自己发广播，所以只暴露系统要用的那一个 action。 -->
        <receiver
            android:name=".ui.widget.BillsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_bills_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bills_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.BillsWidgetMediumReceiver"
            android:exported="false"
            android:label="@string/widget_bills_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bills_widget_medium_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.BillsWidgetCompactReceiver"
            android:exported="false"
            android:label="@string/widget_bills_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bills_widget_compact_info" />
        </receiver>

        <!-- 健康体重同样三格规格，选取器里和买菜卡并排摆 -->
        <receiver
            android:name=".ui.widget.HealthWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_health_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.HealthWidgetMediumReceiver"
            android:exported="false"
            android:label="@string/widget_health_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_widget_medium_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.HealthWidgetCompactReceiver"
            android:exported="false"
            android:label="@string/widget_health_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_widget_compact_info" />
        </receiver>

        <!-- 下载新版本 apk：App 切后台也要接着下，所以是前台服务，不是 ViewModel 里的协程。
             dataSync 这个类型对得上「用户在屏幕上亲手点了下载」这一动机。 -->
        <service
            android:name=".data.sync.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 更新包落在 cacheDir/updates，安装器是另一个进程，只能经 FileProvider 给 URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
